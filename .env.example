# 사내 웹앱(python -m webapp) 설정 예시.
# 이 파일을 같은 폴더에 ".env"라는 이름으로 복사하고 값을 채운다. ".env"는 깃에 올라가지 않는다.
# 서버를 켤 때마다 export를 칠 필요가 없고, 윈도우 로그온 자동 실행(webapp/start_webapp.bat)도 이 값을 쓴다.

# 공공데이터포털 인증키(Decoding) — 입찰공고정보서비스·사전규격정보서비스 활용신청이 된 키
NARA_SERVICE_KEY=여기에_Decoding_키

# 팀원이 사내망으로 접속하게 (이 PC에서만 쓸 거면 127.0.0.1)
HOST=0.0.0.0
PORT=8765

# 접속 토큰 — 주소 끝의 ?t= 값. 고정해 두면 서버를 다시 켜도 주소가 안 바뀐다
APP_TOKEN=jiil2026

# AI 판단을 쓸 때만
# ANTHROPIC_API_KEY=

# jiil-past-contracts가 이 레포 옆 폴더가 아니면
# JIIL_REPO=C:/Users/HJE/jiil-past-contracts
